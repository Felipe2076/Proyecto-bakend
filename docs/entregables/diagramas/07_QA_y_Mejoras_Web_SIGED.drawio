<mxfile host="SIGED" agent="generador" version="24.7.17"><diagram id="p1" name="01 Actividad · proceso de QA y mejora"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de actividad · Proceso de aseguramiento de calidad (QA) de la página web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Cómo se pasó del prototipo a una página sin datos simulados: auditoría completa, reporte priorizado, corrección por fases con pruebas y verificación antes de desplegar.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;act&lt;/b&gt; [activity] QA y mejora continua" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=247;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1460" height="1090" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Equipo (auditoría)&lt;/b&gt;" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="440" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=Arial;rounded=0;fillColor=none;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="440" height="1000" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Equipo (desarrollo)&lt;/b&gt;" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EA;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="440" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=Arial;rounded=0;fillColor=none;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="440" height="1000" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Verificación y despliegue&lt;/b&gt;" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3E6;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="500" height="30" as="geometry"/></mxCell><mxCell id="c8" value="" style="fontFamily=Arial;rounded=0;fillColor=none;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="500" height="1000" as="geometry"/></mxCell><mxCell id="c9" value="" style="fontFamily=Arial;ellipse;fillColor=#000000;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="247" y="145" width="26" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Auditar todo el código en 3 frentes paralelos: organizaciones y usuarios · vistas y plantillas · API y despliegue" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="140" y="190" width="240" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Reporte de QA: ~110 hallazgos con archivo:línea, severidad y corrección" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="220" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Priorizar en 7 fases (errores críticos → datos reales → formularios → rendimiento → foto → despliegue)" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="140" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Tomar la fase siguiente" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="610" y="410" width="220" height="50" as="geometry"/></mxCell><mxCell id="c14" value="Corregir en el código" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="610" y="510" width="220" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Escribir pruebas automáticas de la fase" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="610" y="610" width="220" height="50" as="geometry"/></mxCell><mxCell id="c16" value="¿Toda la suite aprueba? (SQLite, datos ficticios)" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF8E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="645" y="710" width="150" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Analizar la falla y corregir" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="140" y="725" width="220" height="50" as="geometry"/></mxCell><mxCell id="c18" value="¿Quedan fases?" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF8E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="645" y="850" width="150" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Revisión en navegador: 30 pantallas, errores provocados y vista a 360 px" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="220" height="50" as="geometry"/></mxCell><mxCell id="c20" value="Generar SQL de MySQL y comprobar que solo agrega columnas y tablas" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1100" y="710" width="220" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Desplegar con verificación SHA-256, respaldo y reversión" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1100" y="820" width="220" height="50" as="geometry"/></mxCell><mxCell id="c22" value="Actualizar reporte: corregido / no aplica (motivo) / pendiente" style="fontFamily=Arial;rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1100" y="930" width="220" height="50" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;ellipse;shape=endState;fillColor=#000000;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="1197" y="1060" width="30" height="30" as="geometry"/></mxCell><mxCell id="c40" value="Resultado: 276 pruebas automáticas aprobadas (10 omitidas por requerir archivos de simulación que no vienen en el repositorio). Reglas pedidas por el cliente que se mantuvieron a propósito: el RUT de la directiva con dígito incorrecto se acepta con aviso; el sitio parte en el login." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="420" height="120" as="geometry"/></mxCell><mxCell id="c24" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;edgeStyle=none;rounded=1;arcSize=6;exitX=0.0000;exitY=0.5769;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3333;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="160"/></Array></mxGeometry></mxCell><mxCell id="c25" value="" style