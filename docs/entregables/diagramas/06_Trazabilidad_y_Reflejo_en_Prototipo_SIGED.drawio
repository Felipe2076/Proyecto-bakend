/root></mxGraphModel></diagram><diagram id="p4" name="04 Catálogo maestro de casos de uso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Catálogo maestro de casos de uso · SIGED-SGR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Fuente única de nombres: diagramas, trazabilidad y mapa de navegación usan exactamente estos códigos y nombres.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px;border-color:#888&quot;&gt;&lt;tr style=&quot;background:#7A1F2B;color:#fff&quot;&gt;&lt;td style=&quot;padding:5px 6px&quot;&gt;&lt;b&gt;Código&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Nombre oficial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Actor principal&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;CU general&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Pantalla / ruta&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Estado&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Registrar requerimiento ciudadano&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Operador de ventanilla&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G01&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/requerimientos/nuevo/ · /requerimientos/&amp;lt;ticket&amp;gt;/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Registrar actividad diaria&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/actividades/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Gestionar compromisos ciudadanos&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/tubo-trabajo/ · /control/compromisos/nuevo/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Gestionar evidencias y revisión&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/actividades/&amp;lt;código&amp;gt;/revision/ · /control/actividades/&amp;lt;código&amp;gt;/evidencia/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Medir desempeño y semáforo de gestión&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G03&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/semaforo-sgr/ · /control/funcionarios/ · /control/resumen/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Enrutar y asignar tickets territoriales&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G01&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/requerimientos/&amp;lt;ticket&amp;gt;/ · /control/areas/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Semáforo de tickets y tablero Kanban&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G01&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/lista/ · /control/kanban/ · /control/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Medir satisfacción del vecino&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Operador de ventanilla&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G01&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/encuestas/ · /encuestas/responder/&amp;lt;token&amp;gt;/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Consultar dashboard ejecutivo&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G03&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/ · /control/resumen/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrar usuarios, cargos y parámetros&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrador de delegación&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G04&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/administracion/usuarios/ · /administracion/cargos/ · /administracion/parametros/ · /administracion/grupos/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Gestionar agenda colectiva&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/agenda/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Cerrar mes y reportar gestión (propuesto)&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G03&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Sin pantalla: diseño propuesto&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Propuesto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Gestionar organizaciones comunitarias&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrador de delegación&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G05&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/mantenedores/organizaciones/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E14&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Mover compromisos en el tubo de tarjetas&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/control/tubo-cartas/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E15&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Configurar trimestre&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Superusuario&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G04&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/mantenedores/periodos/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E16&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Registrar ausencias y ajustar metas&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrador de delegación&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G03&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/mantenedores/ausencias/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E17&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Iniciar sesión&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Usuario interno&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G06&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/login/ · /activar/ · /logout/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E18&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrar alcance por delegación&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Administrador de delegación&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G04&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Todas las rutas protegidas · /administracion/grupos/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E19&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Registrar atención ciudadana&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Operador de ventanilla&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G01&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/mantenedores/atenciones/ · /control/tubo-cartas/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;&lt;b&gt;CU-E20&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Recuperar contraseña&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Usuario interno&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;CU-G06&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;/recuperar/ · /recuperar/codigo/ · /recuperar/nueva/&lt;/td&gt;&lt;td style=&quot;padding:4px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Arial;text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;overflow=fill;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1440" height="880" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="03 Nuevos requerimientos funcionales"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Catálogo de requerimientos funcionales nuevos (RF-17 a RF-26, alcance web)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Se suman a RF-01…RF-16 del informe de la Etapa 2. Origen: nuevo requerimiento del cliente (correo de la Coordinación de Delegaciones, base de JJVV, formato del tubo en tarjetas y descriptor de funciones) y lo implementado en el código.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] Requerimientos funcionales nuevos" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=331;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1460" height="770" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Gestionar organizaciones comunitarias&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-17&lt;br&gt;Text: Catálogo OROC por delegación y territorio: directiva, datos legales, verificación e importación sin duplicados." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="660" height="115" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Aplicar reglas de puntaje de la matriz&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-18&lt;br&gt;Text: Máx. 7 actividades/día, cierre semanal el martes, solo suma el resultado aprobado, tope 120 %, felicitaciones validadas por el delegado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="660" height="115" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Registrar ausencias y ajustar metas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-19&lt;br&gt;Text: Licencias, vacaciones, días administrativos, emergencias y compensatorios ingresados por el delegado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="660" height="115" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Ver el tubo en tarjetas (Card / Canvas)&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-20&lt;br&gt;Text: Columnas por estado con KPI; mover arrastrando o eligiendo estado; vencido como distintivo." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="660" height="115" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Configurar el trimestre&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-21&lt;br&gt;Text: Nombre y días automáticos, sin solapamiento; trimestre vigente visible arriba con % de días." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="660" height="115" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Registrar atenciones ciudadanas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-22&lt;br&gt;Text: Tipo y subatención dependiente; delegación y responsable desde el contexto del usuario." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="390" width="660" height="115" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Ingresar y recuperar el acceso&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-23&lt;br&gt;Text: Login por RUT, recuperación con código de un uso por correo, activación de cuentas nuevas." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="660" height="115" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Encapsular cada delegación&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-24&lt;br&gt;Text: Cada administrador ve solo su delegación; el superusuario ve todas y edita la configuración global." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="530" width="660" height="115" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Exportar el trabajo propio a Excel&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RF-26&lt;br&gt;Text: Exportación del filtro aplicado, limitada al alcance autorizado y sin campos internos." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="660" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>