"880" width="195" height="40" as="geometry"/></mxCell><mxCell id="c97" value="«implementa»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8;dashed=1;strokeColor=#7A1F2B;fontSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c95" target="c96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c98" value="&lt;b&gt;Enlace de encuesta del vecino&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;/encuestas/responder/&amp;lt;token&amp;gt;/&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="920" y="928" width="330" height="40" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;CU-E08&lt;/b&gt; Medir satisfacción del vecino" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#333;fillColor=#E3F2E1;" vertex="1" parent="1"><mxGeometry x="1300" y="928" width="195" height="40" as="geometry"/></mxCell><mxCell id="c100" value="«implementa»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8;dashed=1;strokeColor=#7A1F2B;fontSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c98" target="c99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c101" value="&lt;b&gt;Leyenda:&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="1008" width="70" height="20" as="geometry"/></mxCell><mxCell id="c102" value="Pantalla (ruta)" style="fontFamily=Arial;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="120" y="1006" width="110" height="26" as="geometry"/></mxCell><mxCell id="c103" value="CU" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontSize=9;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="330" y="1006" width="60" height="26" as="geometry"/></mxCell><mxCell id="c104" value="«implementa»" style="fontFamily=Arial;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;strokeColor=#7A1F2B;fontSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="232" y="1019" as="sourcePoint"/><mxPoint x="328" y="1019" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c105" value="" style="fontFamily=Arial;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="60" y="1048" width="18" height="14" as="geometry"/></mxCell><mxCell id="c106" value="CU implementado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="84" y="1044" width="170" height="20" as="geometry"/></mxCell><mxCell id="c107" value="" style="fontFamily=Arial;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="260" y="1048" width="18" height="14" as="geometry"/></mxCell><mxCell id="c108" value="CU parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="284" y="1044" width="170" height="20" as="geometry"/></mxCell><mxCell id="c109" value="Todas las flechas son «implementa» (pantalla → caso de uso); una pantalla con dos casos tiene dos flechas desde la pantalla. No hay generalizaciones en este diagrama. CU-E11 se ejecuta desde la agenda interna y desde el mantenedor de organizaciones (mismo calendario EventoAgenda). La navegación entre pantallas está en el diagrama siguiente. CU-E12 (cierre mensual) no tiene pantalla: es diseño propuesto. Los 19 restantes se recorren en el prototipo desde el menú o desde otra pantalla (&quot;Fuera del menú&quot;: detalle, revisión, login y enlace del vecino)." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="620" y="1004" width="1000" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="03 Navegación entre pantallas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Mapa de navegación entre pantallas · SIGED-SGR (página web)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Flechas = navegación real (enlace o botón) con su disparador. Desde el Panel se llega a cualquier pantalla del menú lateral, según el rol.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;uc&lt;/b&gt; Navegación de la interfaz web" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=233;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1660" height="970" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Iniciar sesión&lt;/b&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="250" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Recuperar contraseña&lt;/b&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="265" width="250" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Activar cuenta&lt;/b&gt;" style="fontFamily