00" width="250" height="56" as="geometry"/></mxCell><mxCell id="c43" value="Activar cuenta y Recuperar contraseña terminan volviendo a Iniciar sesión. El menú lateral (desde el Panel) da acceso a todas las pantallas permitidas por el rol; aquí se dibujan las navegaciones internas entre pantallas." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="1000" height="60" as="geometry"/></mxCell><mxCell id="c26" value="¿Olvidaste tu contraseña?" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;fontSize=9;edgeStyle=none;rounded=1;arcSize=6;exitX=0.0800;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0800;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.001"></mxGeometry></mxCell><mxCell id="c28" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;fontSize=9;edgeStyle=none;rounded=1;arcSize=6;exitX=0.0800;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0800;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="avatar" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;fontSize=9;edgeStyle=none;rounded=1;arcSize=6;exitX=0.0800;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0800;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" x="0.001"></mxGeometry></mxCell><mxCell id="c35" value="enlace firmado" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=