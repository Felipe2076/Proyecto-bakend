d=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="285.5" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Agenda compartida&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-12&lt;br&gt;Text: Como funcionario, quiero ver eventos, compromisos y actividades por fecha." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-12.1&lt;br&gt;Text: Debe mostrar vista calendario y lista por mes." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="126.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:cen