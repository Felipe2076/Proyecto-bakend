left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="352.0" width="330" height="77" as="geometry"/></mxCell><mxCell id="c13" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-14.1&lt;br&gt;Text: Debe destacar compromisos vencidos no realizados." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="352.0" width="330" height="77" as="geometry"/></mxCell><mxCell id="c15" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Continuidad operativa&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-15&lt;br&gt;Text: Como jefatura, quiero reasignar por ausencia con historial." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="455.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c17" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackg