ell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Semáforo diario de tickets&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-40&lt;br&gt;Text: Como jefatura, quiero ver la antigüedad de tickets." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="126.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-40.1&lt;br&gt;Text: Verde hasta 3 días, amarillo hasta 5, rojo sobre 5 (parametrizable)." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Cuellos de botella&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-41&lt;br&gt;Text: Como jefatura, quiero detectar tickets estancados." style="fontFamily=Arial;rounded=0;whiteSpa