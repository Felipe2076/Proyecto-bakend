mxGeometry x="64" y="676" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14 EP-13 Organizaciones comunitarias"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="888" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de requerimientos · EP-13 Organizaciones comunitarias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Épica → historias de usuario («deriveReqt») → criterios verificables («refine»). El color de cada criterio indica su estado en el código.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] EP-13 Organizaciones comunitarias" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=331;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="778" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Organizaciones comunitarias&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: EP-13&lt;br&gt;Text: El sistema debe mantener el catálogo de organizaciones (JJVV y funcionales) por delegación y territorio." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="344.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Catálogo de organizaciones&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-49&lt;br&gt;Text: Como encargado OOCC, quiero cargar la base de JJVV y organizaciones." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="172.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-49.1&lt;br&gt;Text: Debe importar sin duplicar (clave de origen) y generar código ORG." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-49.2&lt;br&gt;Text: Debe buscar por nombre, territorio, registro jurídico o directiva." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="224.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c9" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Directiva y datos legales&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-50&lt;br&gt;Text: Como encargado OOCC, quiero registrar la directiva." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="346.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c11" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-50.1&lt;br&gt;Text: Presidencia, tesorería y secretaría con nombre y RUT; PJ, socios y fechas." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="340.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Verificación y territorio&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-51&lt;br&gt;Text: Como administrador de delegación, quiero verificar y asignar delegación." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="456.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c15" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c14"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-51.1&lt;br&gt;Text: El territorio se elige solo entre los de la delegación; &amp;quot;verificada&amp;quot; tras revisar." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="456.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c17" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Agenda de organizaciones&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-52&lt;br&gt;Text: Como funcionario, quiero registrar actividades con organizaciones." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="572.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c19" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c18"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c20" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-52.1&lt;br&gt;Text: Debe registrar actividad, fecha, hora, lugar y organización, visible en la agenda." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="572.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c21" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="698" width="250" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;rounded=0;fillColor=#FBE3E6;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="18" height="14" as="geometry"/></mxCell><mxCell id="c24" value="Nuevo: Unidad 3 o codificado después de la Etapa 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="718" width="300" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="18" height="14" as="geometry"/></mxCell><mxCell id="c26" value="Requerimiento de Unidades 1 y 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="740" width="300" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Arial;rounded=0;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="766" width="18" height="14" as="geometry"/></mxCell><mxCell id="c28" value="Implementado y probado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="762" width="300" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="18" height="14" as="geometry"/></mxCell><mxCell id="c30" value="Parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="784" width="300" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="fontFamily=Arial;rounded=0;fillColor=#EEEEEE;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="18" height="14" as="geometry"/></mxCell><mxCell id="c32" value="Propuesto (no implementado)" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="806" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="15 EP-14 Reglas de puntaje de la matriz SGR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="979" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de requerimientos · EP-14 Reglas de puntaje de la matriz SGR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Épica → historias de usuario («deriveReqt») → criterios verificables («refine»). El color de cada criterio indica su estado en el código.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] EP-14 Reglas de puntaje de la matriz SGR" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=380;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="869" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Reglas de puntaje de la matriz SGR&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: EP-14&lt;br&gt;Text: El sistema debe aplicar las reglas enviadas por la Coordinación de Delegaciones (oct. 2026)." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="389.5" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Ingreso diario controlado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-53&lt;br&gt;Text: Como coordinación, quiero que se registre a diario." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="172.0" width="330" height="77" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-53.1&lt;br&gt;Text: Máximo 7 actividades por día y funcionario." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="77" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-53.2&lt;br&gt;Text: La semana cierra el martes siguiente; no se admiten fechas futuras." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="211.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c9" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Puntaje solo por resultado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-54&lt;br&gt;Text: Como coordinación, quiero puntuar la acción realizada." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="379.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-54.1&lt;br&gt;Text: Solo suma un &amp;quot;Resultado&amp;quot; aprobado; coordinación y gestión del delegado no suman." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="327.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-54.2&lt;br&gt;Text: Exigir nombre y teléfono del usuario para puntuar (hoy solo se exige el contacto)." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFF2C2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="431.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c15" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Tope y felicitaciones&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-55&lt;br&gt;Text: Como coordinación, quiero evitar puntaje inflado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="553.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c17" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c18" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-55.1&lt;br&gt;Text: Tope 120 % por ítem; felicitación válida solo si la valida el delegado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="547.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c19" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Ausencias y ajuste de metas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-56&lt;br&gt;Text: Como delegado, quiero ingresar licencias y vacaciones." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="663.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c21" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c20"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c22" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-56.1&lt;br&gt;Text: Licencia, vacaciones, administrativo, emergencia o compensatorio ajustan la meta." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="663.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c23" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="789" width="250" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Arial;rounded=0;fillColor=#FBE3E6;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="813" width="18" height="14" as="geometry"/></mxCell><mxCell id="c26" value="Nuevo: Unidad 3 o codificado después de la Etapa 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="809" width="300" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="18" height="14" as="geometry"/></mxCell><mxCell id="c28" value="Requerimiento de Unidades 1 y 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="831" width="300" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=Arial;rounded=0;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="857" width="18" height="14" as="geometry"/></mxCell><mxCell id="c30" value="Implementado y probado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="853" width="300" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="879" width="18" height="14" as="geometry"/></mxCell><mxCell id="c32" value="Parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="875" width="300" height="20" as="geometry"/></mxCell><mxCell id="c33" value="" style="fontFamily=Arial;rounded=0;fillColor=#EEEEEE;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="901" width="18" height="14" as="geometry"/></mxCell><mxCell id="c34" value="Propuesto (no implementado)" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="897" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="16 EP-15 Tubo de compromisos en tarjetas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="784" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de requerimientos · EP-15 Tubo de compromisos en tarjetas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Épica → historias de usuario («deriveReqt») → criterios verificables («refine»). El color de cada criterio indica su estado en el código.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] EP-15 Tubo de compromisos en tarjetas" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=359;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="674" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Tubo de compromisos en tarjetas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: EP-15&lt;br&gt;Text: El sistema debe mostrar el tubo en formato Card / Canvas por estado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="292.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Tablero de tarjetas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-57&lt;br&gt;Text: Como funcionario, quiero ver mis compromisos por columna." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-57.1&lt;br&gt;Text: Columnas Ingresado, Pendiente, En proceso, Realizado y KPI superiores." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Mover tarjetas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-58&lt;br&gt;Text: Como funcionario, quiero arrastrar o elegir el nuevo estado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="236.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c9" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-58.1&lt;br&gt;Text: Debe guardar autor y estado anterior; control de concurrencia." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="236.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Vencido como distintivo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-59&lt;br&gt;Text: Como jefatura, quiero ver lo vencido sin perder el estado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="352.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-59.1&lt;br&gt;Text: Vencido es un distintivo calculado, no una columna ni un estado." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="352.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c15" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Atenciones en el tubo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-60&lt;br&gt;Text: Como funcionario, quiero ver atenciones junto a compromisos." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="468.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c17" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c18" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-60.1&lt;br&gt;Text: Las atenciones se muestran y mueven en las mismas columnas." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="468.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c19" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="594" width="250" height="20" as="geometry"/></mxCell><mxCell id="c21" value="" style="fontFamily=Arial;rounded=0;fillColor=#FBE3E6;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="18" height="14" as="geometry"/></mxCell><mxCell id="c22" value="Nuevo: Unidad 3 o codificado después de la Etapa 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="614" width="300" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="18" height="14" as="geometry"/></mxCell><mxCell id="c24" value="Requerimiento de Unidades 1 y 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="636" width="300" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Arial;rounded=0;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="18" height="14" as="geometry"/></mxCell><mxCell id="c26" value="Implementado y probado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="658" width="300" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="18" height="14" as="geometry"/></mxCell><mxCell id="c28" value="Parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="680" width="300" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=Arial;rounded=0;fillColor=#EEEEEE;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="18" height="14" as="geometry"/></mxCell><mxCell id="c30" value="Propuesto (no implementado)" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="702" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p17" name="17 EP-16 Acceso, perfiles y alcance por delegación"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="772" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de requerimientos · EP-16 Acceso, perfiles y alcance por delegación&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Épica → historias de usuario («deriveReqt») → criterios verificables («refine»). El color de cada criterio indica su estado en el código.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] EP-16 Acceso, perfiles y alcance por delegación" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=429;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="662" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Acceso, perfiles y alcance por delegación&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: EP-16&lt;br&gt;Text: El sistema debe autenticar, autorizar por rol y encapsular cada delegación." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="286.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Ingreso y recuperación&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-61&lt;br&gt;Text: Como usuario, quiero entrar con RUT y recuperar mi clave." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-61.1&lt;br&gt;Text: Código de un uso por correo con vigencia, intentos y respuesta genérica." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Perfiles y permisos&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-62&lt;br&gt;Text: Como superusuario, quiero permisos por grupo de rol." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="242.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c9" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-62.1&lt;br&gt;Text: Roles: superusuario, administrador de delegación, jefatura, funcionario y ventanilla." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="236.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Encapsulamiento por delegación&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-63&lt;br&gt;Text: Como superusuario, quiero que cada administrador vea solo su delegación." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="404.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-63.1&lt;br&gt;Text: Validación en servidor; otra delegación por URL se rechaza." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="352.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c15" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-63.2&lt;br&gt;Text: Solo el superusuario ve todas las delegaciones y lo global." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="456.0" width="330" height="90" as="geometry"/></mxCell><mxCell id="c17" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="250" height="20" as="geometry"/></mxCell><mxCell id="c19" value="" style="fontFamily=Arial;rounded=0;fillColor=#FBE3E6;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="18" height="14" as="geometry"/></mxCell><mxCell id="c20" value="Nuevo: Unidad 3 o codificado después de la Etapa 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="602" width="300" height="20" as="geometry"/></mxCell><mxCell id="c21" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="18" height="14" as="geometry"/></mxCell><mxCell id="c22" value="Requerimiento de Unidades 1 y 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="624" width="300" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;rounded=0;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="18" height="14" as="geometry"/></mxCell><mxCell id="c24" value="Implementado y probado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="646" width="300" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="18" height="14" as="geometry"/></mxCell><mxCell id="c26" value="Parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="668" width="300" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Arial;rounded=0;fillColor=#EEEEEE;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="18" height="14" as="geometry"/></mxCell><mxCell id="c28" value="Propuesto (no implementado)" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="690" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p18" name="18 Requerimientos no funcionales"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de requerimientos · No funcionales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Atributos de calidad que restringen a todas las épicas. RNF-09 y RNF-10 se agregan por la segunda y tercera evaluación (normas gráficas y OWASP).&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;req&lt;/b&gt; [package] Requerimientos no funcionales" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=303;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="890" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Calidad del servicio SIGED-SGR&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RQ-CAL&lt;br&gt;Text: El sistema debe operar de forma segura, confiable, usable y mantenible." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="360" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Autorización por rol y territorio&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-01&lt;br&gt;Text: Toda operación verifica sesión, rol y delegación; el superusuario ve las seis." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="330" height="110" as="geometry"/></mxCell><mxCell id="c5" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="155"/><mxPoint x="500" y="295"/></Array></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Integridad y consistencia&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-02&lt;br&gt;Text: Sin doble conteo; operaciones atómicas; período cerrado no se modifica." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="240" width="330" height="110" as="geometry"/></mxCell><mxCell id="c7" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="155"/><mxPoint x="900" y="295"/></Array></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Usabilidad móvil&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-03&lt;br&gt;Text: Flujos críticos usables a 360 px sin desplazamiento horizontal." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="330" height="110" as="geometry"/></mxCell><mxCell id="c9" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="155"/><mxPoint x="500" y="435"/></Array></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Rendimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-04&lt;br&gt;Text: p95 &amp;lt;= 3 s con 30 usuarios simultáneos (meta por medir)." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="330" height="110" as="geometry"/></mxCell><mxCell id="c11" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="155"/><mxPoint x="900" y="435"/></Array></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Privacidad de datos&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-05&lt;br&gt;Text: Datos del vecino solo a perfiles autorizados y por HTTPS." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="330" height="110" as="geometry"/></mxCell><mxCell id="c13" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="155"/><mxPoint x="500" y="575"/></Array></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Configurabilidad&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-06&lt;br&gt;Text: Catálogos y umbrales se cambian sin editar código." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="520" width="330" height="110" as="geometry"/></mxCell><mxCell id="c15" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="155"/><mxPoint x="900" y="575"/></Array></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Respaldo y recuperación&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-07&lt;br&gt;Text: Respaldo antes de cada cambio y restauración probada (RPO 24 h, RTO 4 h)." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="330" height="110" as="geometry"/></mxCell><mxCell id="c17" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="155"/><mxPoint x="500" y="715"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Trazabilidad y concurrencia&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-08&lt;br&gt;Text: Actor, fecha y cambio en operaciones críticas; sin sobrescritura silenciosa." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="660" width="330" height="110" as="geometry"/></mxCell><mxCell id="c19" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="155"/><mxPoint x="900" y="715"/></Array></mxGeometry></mxCell><mxCell id="c20" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Identidad gráfica institucional&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-09&lt;br&gt;Text: Template con normas gráficas de La Serena; delegación, usuario y rol visibles." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="330" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="155"/><mxPoint x="500" y="855"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Seguridad OWASP&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: RNF-10&lt;br&gt;Text: CSRF, sesiones seguras, contraseñas con hash, archivos validados, MySQL con mínimo privilegio." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="800" width="330" height="110" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="155"/><mxPoint x="900" y="855"/></Array></mxGeometry></mxCell><mxCell id="c24" value="Cómo se cumple hoy (evidencia en el código y en el servidor):&lt;br&gt;• RNF-01: permisos por grupo de rol + ámbito por delegación validado en servidor.&lt;br&gt;• RNF-05/10: HTTPS en Apache, CSRF y cookies seguras de Django, hash de contraseñas.&lt;br&gt;• RNF-07: cada despliegue respalda MySQL, .env y archivos y revierte solo si falla.&lt;br&gt;• RNF-10: usuario MySQL de la aplicación solo con SELECT/INSERT/UPDATE/DELETE.&lt;br&gt;• RNF-04: meta de diseño; la prueba de carga queda pendiente." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="470" y="260" width="470" height="170" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="820" width="250" height="20" as="geometry"/></mxCell><mxCell id="c26" value="" style="fontFamily=Arial;rounded=0;fillColor=#FBE3E6;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="520" y="844" width="18" height="14" as="geometry"/></mxCell><mxCell id="c27" value="Nuevo: Unidad 3 o codificado después de la Etapa 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="840" width="300" height="20" as="geometry"/></mxCell><mxCell id="c28" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="520" y="866" width="18" height="14" as="geometry"/></mxCell><mxCell id="c29" value="Requerimiento de Unidades 1 y 2" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="862" width="300" height="20" as="geometry"/></mxCell><mxCell id="c30" value="" style="fontFamily=Arial;rounded=0;fillColor=#E3F2E1;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="520" y="888" width="18" height="14" as="geometry"/></mxCell><mxCell id="c31" value="Implementado y probado" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="884" width="300" height="20" as="geometry"/></mxCell><mxCell id="c32" value="" style="fontFamily=Arial;rounded=0;fillColor=#FFF2C2;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="520" y="910" width="18" height="14" as="geometry"/></mxCell><mxCell id="c33" value="Parcial" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="906" width="300" height="20" as="geometry"/></mxCell><mxCell id="c34" value="" style="fontFamily=Arial;rounded=0;fillColor=#EEEEEE;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="520" y="932" width="18" height="14" as="geometry"/></mxCell><mxCell id="c35" value="Propuesto (no implementado)" style="fontFamily=Arial;text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="928" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>