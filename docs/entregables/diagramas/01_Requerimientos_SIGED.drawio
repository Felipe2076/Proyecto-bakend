ajería: propuesto." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="120.0" width="330" height="77" as="geometry"/></mxCell><mxCell id="c7" value="«refine»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Encuesta express&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-46&lt;br&gt;Text: Como vecino, quiero evaluar la atención de 1 a 5." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="229.5" width="330" height="77" as="geometry"/></mxCell><mxCell id="c9" value="«deriveReqt»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry" x="0.62"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;Implementado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Id: HU-46.1&lt;br&gt;Text: Enlace firmado (30 días) para responder sin cuenta, solo con ticket resuelto." style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#E3F2E1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="223.0" width="330" height="90" as="geometry"/></mxCell><