y"></mxGeometry></mxCell><mxCell id="c23" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c11" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c12" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:10px;border-color:#888&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#7A1F2B;color:#fff;padding:4px 6px&quot;&gt;&lt;b&gt;Cuadro de descripción · CU-E14 Mover compromisos en el tubo de tarjetas&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Identificador&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-E14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Nombre&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Mover compromisos en el tubo de tarjetas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Caso general&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actor principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actores secundarios&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Propósito&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Ver y avanzar los compromisos y atenciones en formato Card / Canvas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Precondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Sesión con permiso de compromisos; registros dentro del ámbito.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Postcondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Nuevo estado guardado con autor; KPI recalculados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Abrir tubo de tarjetas → arrastrar a Ingresado, Pendiente, En proceso o Realizado → sistema valida y guarda.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos incluidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Calcular KPI del tubo, Mostrar distintivo &amp;quot;Vencido&amp;quot;, Incluir atenciones, Registrar cambio con autor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos extendidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Elegir estado y pulsar Mover, Avisar conflicto concurrente, Filtrar y buscar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Pantalla / ruta en el prototipo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;/control/tubo-cartas/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Estado en el código&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px