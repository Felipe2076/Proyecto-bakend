ador&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-E02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Nombre&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Registrar actividad diaria&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Caso general&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actor principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actores secundarios&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Propósito&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Dejar constancia diaria del trabajo realizado y su aporte a la matriz SGR.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Precondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Funcionario con sesión, ítems de la matriz asignados y trimestre vigente.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Postcondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Actividad ACT con verificador, en estado Pendiente de revisión; no suma hasta ser aprobada.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Abrir Actividad y evidencia → elegir ítem y tipo de registro → contacto y servicio → validar reglas → guardar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos incluidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Seleccionar ítem de la matriz SGR, Validar reglas de la matriz, Generar código ACT y verificador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos extendidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Adjuntar evidencia, Rechazar 8.ª actividad del día, Rechazar semana cerrada o fecha futura, Filtrar por trimestre&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Pantalla / ruta en el prototipo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;/control/actividades/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Estado en el código&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Arial;text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1280" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="05 CU-E03 Gestionar compromisos ciudadanos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Caso de uso detallado · CU-E03 Gestionar compromisos ciudadanos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Pertenece a CU-G02. Estado en el código: Implementado. Pantalla: /control/tubo-trabajo/ · /control/compromisos/nuevo/&lt;/span&gt;"