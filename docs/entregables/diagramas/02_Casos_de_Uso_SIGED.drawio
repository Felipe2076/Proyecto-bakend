ctores secundarios&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Propósito&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Registrar la atención presencial con su tipo y subatención.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Precondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Catálogos de tipo y subatención activos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Postcondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Atención con vecino, tipo, subatención, delegación, responsable y fecha.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Abrir Atenciones → vecino → tipo → subatención dependiente → guardar → confirmación con identificador.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos incluidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Seleccionar tipo de atención, Filtrar subatención por tipo, Completar delegación desde el contexto, Registrar responsable y fecha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos extendidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Limpiar subatención inválida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Pantalla / ruta en el prototipo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;/mantenedores/atenciones/ · /control/tubo-cartas/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=