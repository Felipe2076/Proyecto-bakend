mxCell><mxCell id="c23" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c12" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:10px;border-color:#888&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#7A1F2B;color:#fff;padding:4px 6px&quot;&gt;&lt;b&gt;Cuadro de descripción · CU-E03 Gestionar compromisos ciudadanos&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Identificador&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-E03&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Nombre&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Gestionar compromisos ciudadanos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Caso general&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-G02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actor principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Funcionario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actores secundarios&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Jefatura&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Propósito&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Registrar y dar seguimiento a lo comprometido con el vecino hasta realizarlo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Precondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Sesión con permiso de compromisos; vecino, delegación y funcionario registrados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Postcondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Compromiso TUB con estado vigente y cambio auditado (autor, estado anterior y nuevo).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Abrir tubo → nuevo o editar → validar → guardar → cambiar estado (Ingresado → Pendiente → En proceso → Realizado).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos incluidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Validar vecino, responsable y fecha, Registrar autor y estado anterior&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos extendidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Avisar cambio concurrente, Destacar vencidos, Exportar Excel propio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Pantalla / ruta en el prototipo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;/control/tubo-trabajo/ · /control/compromisos/nuevo/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Estado en el código&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Arial;text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1280" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="06 CU-E04 Gestionar evidencias y revisión"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Caso de uso detallado · CU-E04 Gestionar evidencias y revisión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Pertenece a CU-G02. Estado en el código: Implementado. Pantalla: /control/actividades/&amp;lt;código&amp;gt;/revision/ · /control/actividades/&amp;lt;código&amp;gt;/evidencia/&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;uc&lt;/b&gt; [package] CU-E04 Gestionar evidencias y revisión" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=366;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="1290" as="geometry"/></mxCell><mxCell id="c3" value="SIGED-SGR" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#222