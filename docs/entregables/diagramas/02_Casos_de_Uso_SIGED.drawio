<mxfile host="SIGED" agent="generador" version="24.7.17"><diagram id="p1" name="01 Actores y permisos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Actores del sistema y jerarquía de permisos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Tomado del código (cuentas/perfiles.py): cada rol incluye los módulos del anterior. Vecino, Servidor de correo y App móvil son actores externos.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;uc&lt;/b&gt; [package] Actores SIGED-SGR" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=219;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1460" height="810" as="geometry"/></mxCell><mxCell id="c3" value="Operador de ventanilla" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="34" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Operador de ventanilla&lt;/b&gt;&lt;br&gt;Registra lo que llega por ventanilla, WhatsApp o correo.&lt;br&gt;&lt;span style=&quot;color:#7A1F2B&quot;&gt;Módulos: Atención ciudadana · Agenda · Avisos · Encuestas&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="132" width="560" height="62" as="geometry"/></mxCell><mxCell id="c5" value="Funcionario" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="34" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Funcionario&lt;/b&gt;&lt;br&gt;Hace lo del operador y además registra su trabajo territorial.&lt;br&gt;&lt;span style=&quot;color:#7A1F2B&quot;&gt;Módulos: + Indicadores y metas · Actividad y evidencia · Compromisos&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="272" width="560" height="62" as="geometry"/></mxCell><mxCell id="c7" value="Jefatura" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="150" y="410" width="34" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Jefatura&lt;/b&gt;&lt;br&gt;Hace lo del funcionario y supervisa la delegación.&lt;br&gt;&lt;span style=&quot;color:#7A1F2B&quot;&gt;Módulos: + Panel de gestión · Mantenedores autorizados&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="412" width="560" height="62" as="geometry"/></mxCell><mxCell id="c9" value="Administrador de delegación" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="150" y="550" width="34" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Administrador de delegación&lt;/b&gt;&lt;br&gt;Hace lo de jefatura y administra las cuentas de SU delegación.&lt;br&gt;&lt;span style=&quot;color:#7A1F2B&quot;&gt;Módulos: + Administración (solo su delegación)&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="552" width="560" height="62" as="geometry"/></mxCell><mxCell id="c11" value="Superusuario" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="150" y="690" width="34" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Superusuario&lt;/b&gt;&lt;br&gt;Hace lo del administrador en las seis delegaciones y edita lo global.&lt;br&gt;&lt;span style=&quot;color:#7A1F2B&quot;&gt;Módulos: Todo, con alcance global&lt;/span&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FBE3E6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="692" width="560" height="62" as="geometry"/></mxCell><mxCell id="c13" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.3;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.3;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.3;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.3;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Vecino" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="34" height="64" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Vecino (externo)&lt;/b&gt;&lt;br&gt;Origina el requerimiento. No tiene cuenta: responde la encuesta por un enlace firmado." style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="132" width="370" height="62" as="geometry"/></mxCell><mxCell id="c19" value="Servidor de correo" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="34" height="64" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Servidor de correo («system»)&lt;/b&gt;&lt;br&gt;Envía códigos de recuperación y enlaces de activación." style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="282" width="370" height="62" as="geometry"/></mxCell><mxCell id="c21" value="App móvil SIGED" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="34" height="64" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;App móvil SIGED («system», en desarrollo)&lt;/b&gt;&lt;br&gt;Usa la API /api/v1/ con la cuenta del funcionario; nunca accede a MySQL." style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="432" width="370" height="62" as="geometry"/></mxCell><mxCell id="c23" value="Cómo leer la jerarquía: la flecha de punta blanca (generalización) apunta al rol más general. Ej.: Jefatura → Funcionario significa que la jefatura puede hacer todo lo del funcionario.&lt;br&gt;&lt;br&gt;El alcance se valida en el servidor: Operador, Funcionario, Jefatura y Administrador solo ven su delegación; el Superusuario ve las seis y es el único que edita delegaciones, roles, metas, cargos, tipos y trimestres." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="450" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="02 Caso de uso general"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de casos de uso general (alto nivel) · SIGED-SGR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Generalización acumulativa de actores: cada rol hereda los casos del rol superior (cuentas/perfiles.py, MODULOS_BASE). Rosado = nuevo en la Unidad 3.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;uc&lt;/b&gt; Casos de uso generales" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=184;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1460" height="1050" as="geometry"/></mxCell><mxCell id="c3" value="SIGED-SGR · Delegaciones Municipales de La Serena" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="560" height="940" as="geometry"/></mxCell><mxCell id="c4" value="Usuario interno" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="34" height="64" as="geometry"/></mxCell><mxCell id="c5" value="Operador de ventanilla" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="34" height="64" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.25;entryX=0;entryY=0.75;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Funcionario" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="34" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.25;entryX=0;entryY=0.75;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Jefatura" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="610" width="34" height="64" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.25;entryX=0;entryY=0.75;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Administrador de delegación" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="760" width="34" height="64" as="geometry"/></mxCell><mxCell id="c12" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.25;entryX=0;entryY=0.75;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Superusuario" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="930" width="34" height="64" as="geometry"/></mxCell><mxCell id="c14" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;exitX=0;exitY=0.25;entryX=0;entryY=0.75;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="CU-G06&lt;br&gt;Gestionar acceso" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FBE3E6;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="132" width="280" height="80" as="geometry"/></mxCell><mxCell id="c16" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="CU-G01&lt;br&gt;Gestionar requerimientos ciudadanos" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="282" width="280" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c5" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="CU-G02&lt;br&gt;Gestionar trabajo territorial" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="432" width="280" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c7" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="CU-G03&lt;br&gt;Supervisar resultados" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="602" width="280" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c9" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="CU-G05&lt;br&gt;Gestionar organizaciones comunitarias" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FBE3E6;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="722" width="280" height="80" as="geometry"/></mxCell><mxCell id="c24" value="{registrar, modificar, consultar, dar de baja}" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c11" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="CU-G04&lt;br&gt;Administrar la plataforma" style="fontFamily=Arial;ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="700" y="842" width="280" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c11" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="«sistema externo»&lt;br&gt;&lt;b&gt;Servidor de correo&lt;/b&gt;" style="fontFamily=Arial;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#555555;html=1;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="c28" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c15" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Vecino" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=11;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1330" y="270" width="34" height="64" as="geometry"/></mxCell><mxCell id="c30" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c29" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="{solo consulta}" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c7" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="{alcance = global}" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c13" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Restricción {alcance = global}: el superusuario ve y administra todas las delegaciones; los demás roles quedan acotados a su propia delegación." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="1150" y="860" width="310" height="90" as="geometry"/></mxCell><mxCell id="c34" value="Desglose en casos específicos:&lt;br&gt;CU-G01 → CU-E01, E06, E07, E08, E19&lt;br&gt;CU-G02 → CU-E02, E03, E04, E11, E14&lt;br&gt;CU-G03 → CU-E05, E09, E12, E16&lt;br&gt;CU-G04 → CU-E10, E15, E18&lt;br&gt;CU-G05 → CU-E13&lt;br&gt;CU-G06 → CU-E17, CU-E20 («extend»)" style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="310" height="160" as="geometry"/></mxCell><mxCell id="c35" value="CU-G05: Funcionario {solo consulta} (Jefatura lo hereda); Administrador de delegación: registrar, modificar, consultar y dar de baja (permisos view/add/change de organizacioncomunitaria)." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="1150" y="600" width="310" height="100" as="geometry"/></mxCell><mxCell id="c36" value="Generalización jerárquica (verificada en cuentas/perfiles.py): cada rol especializado hereda todas las capacidades del rol al que apunta su triángulo. Superusuario → Administrador → Jefatura → Funcionario → Operador de ventanilla → Usuario interno." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="03 CU-E01 Registrar requerimiento ciudadano"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Caso de uso detallado · CU-E01 Registrar requerimiento ciudadano&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Pertenece a CU-G01. Estado en el código: Implementado. Pantalla: /requerimientos/nuevo/ · /requerimientos/&amp;lt;ticket&amp;gt;/&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;uc&lt;/b&gt; [package] CU-E01 Registrar requerimiento ciudadano" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=380;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="990" as="geometry"/></mxCell><mxCell id="c3" value="SIGED-SGR" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#222222;" vertex=