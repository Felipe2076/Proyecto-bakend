ontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="«extend»" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:10px;border-color:#888&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#7A1F2B;color:#fff;padding:4px 6px&quot;&gt;&lt;b&gt;Cuadro de descripción · CU-E20 Recuperar contraseña&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Identificador&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-E20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Nombre&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Recuperar contraseña&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Caso general&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;CU-G06&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actor principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Usuario interno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Actores secundarios&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Servidor de correo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Propósito&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Recuperar el acceso cuando la persona no recuerda su contraseña. Extiende CU-E17 Iniciar sesión.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Precondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Cuenta activa con correo registrado.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Postcondiciones&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Contraseña renovada, código invalidado y sesiones anteriores cerradas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;«¿Olvidaste tu contraseña?» → correo → código de 6 dígitos → validar → nueva contraseña → volver al login.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos incluidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Enviar código de un uso, Validar código, Crear nueva contraseña&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Casos extendidos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Responder sin revelar si la cuenta existe, Limitar intentos y reenvíos, Rechazar código vencido (10 min)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Pantalla / ruta en el prototipo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;/recuperar/ · /recuperar/codigo/ · /recuperar/nueva/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F3E7E9;width:190px;padding:3px 6px&quot;&gt;&lt;b&gt;Estado en el código&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Implementado&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Arial;text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1280" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>