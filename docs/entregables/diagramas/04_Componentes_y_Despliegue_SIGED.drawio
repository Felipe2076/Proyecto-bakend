ll id="c33" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;endSize=10;edgeStyle=none;rounded=1;arcSize=6;exitX=0.8846;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="270"/><mxPoint x="820" y="270"/><mxPoint x="820" y="440"/><mxPoint x="1260" y="440"/></Array></mxGeometry></mxCell><mxCell id="c32" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;endSize=10;edgeStyle=none;rounded=1;arcSize=6;exitX=0.9615;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6333;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c13" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="100"/><mxPoint x="1740" y="100"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="03 Despliegue en AWS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="916" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px;color:#7A1F2B&quot;&gt;Diagrama de despliegue · producción en AWS EC2 con Docker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Topología verificada en el servidor: un EC2 con proxy HTTPS en el host y dos contenedores Docker (app y db) en una red interna. Solo el puerto 443 es público.&lt;/span&gt;" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;dep&lt;/b&gt; [deployment] SIGED-SGR producción" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=261;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontSize=12;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1760" height="816" as="geometry"/></mxCell><mxCell id="c3" value="«device»&lt;br&gt;&lt;b&gt;PC del funcionario&lt;br&gt;Navegador web&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#F2F2F2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="250" height="90" as="geometry"/></mxCell><mxCell id="c4" value="«device»&lt;br&gt;&lt;b&gt;Administrador técnico&lt;br&gt;AWS CloudShell&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#F2F2F2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="250" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«node»&lt;br&gt;&lt;b&gt;AWS EC2 · Amazon Linux (us-east-1) · IP pública&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="1080" height="746" as="geometry"/></mxCell><mxCell id="c6" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Apache 2.4 (host)&lt;br&gt;TLS :443 → proxy 127.0.0.1:8000&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#EAF1FB;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="290" height="110" as="geometry"/></mxCell><mxCell id="c7" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Docker Engine + Compose&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#FAFAFA;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="170" width="660" height="500" as="geometry"/></mxCell><mxCell id="c8" value="«container»&lt;br&gt;&lt;b&gt;Contenedor app (siged-app-1)&lt;br&gt;Gunicorn + Django 6.1&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#EAF6EA;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="280" height="220" as="geometry"/></mxCell><mxCell id="c9" value="«artifact»&lt;br&gt;&lt;b&gt;siged-app:cambio-AAAAMMDD-HHMMSS&lt;/b&gt;" style="fontFamily=Arial;shape=note;size=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="815" y="330" width="250" height="38" as="geometry"/></mxCell><mxCell id="c10" value="«artifact»&lt;br&gt;&lt;b&gt;.env (secretos, fuera de Git)&lt;/b&gt;" style="fontFamily=Arial;shape=note;size=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="815" y="378" width="250" height="36" as="geometry"/></mxCell><mxCell id="c11" value="«container»&lt;br&gt;&lt;b&gt;Contenedor db (siged-db-1)&lt;br&gt;MySQL 8.4 · sin puerto publicado&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#FFF4E0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="240" width="280" height="220" as="geometry"/></mxCell><mxCell id="c12" value="«artifact»&lt;br&gt;&lt;b&gt;BD siged_frontend&lt;/b&gt;" style="fontFamily=Arial;shape=note;size=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1135" y="340" width="250" height="38" as="geometry"/></mxCell><mxCell id="c13" value="volumen&lt;br&gt;evidencias" style="fontFamily=Arial;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="865" y="540" width="150" height="90" as="geometry"/></mxCell><mxCell id="c14" value="volumen&lt;br&gt;mysql-datos" style="fontFamily=Arial;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1185" y="540" width="150" height="90" as="geometry"/></mxCell><mxCell id="c15" value="~/respaldos-siged&lt;br&gt;(MySQL, .env, archivos)" style="fontFamily=Arial;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="465" y="520" width="200" height="110" as="geometry"/></mxCell><mxCell id="c16" value="«external»&lt;br&gt;&lt;b&gt;Servidor de correo SMTP&lt;/b&gt;" style="fontFamily=Arial;shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;fontSize=11;fillColor=#F2F2F2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1510" y="330" width="240" height="80" as="geometry"/></mxCell><mxCell id="c25" value="Controles de seguridad desplegados (OWASP):&lt;br&gt;• Solo el puerto 443 es público; MySQL no publica puertos y solo lo alcanza el contenedor app.&lt;br&gt;• El usuario MySQL de la aplicación solo tiene SELECT/INSERT/UPDATE/DELETE; los cambios de esquema se aplican aparte, con respaldo.&lt;br&gt;• DEBUG=False, cookies de sesión y CSRF seguras, X-Frame-Options DENY y cabeceras de seguridad de Django.&lt;br&gt;• Las evidencias viven en un volumen privado y se entregan por una vista que verifica permisos.&lt;br&gt;• Cada despliegue: verificación SHA-256, respaldo, imagen nueva y reversión automática si falla." style="fontFamily=Arial;shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#FFF8E1;strokeColor=#B0A060;" vertex="1" parent="1"><mxGeometry x="420" y="720" width="1010" height="106" as="geometry"/></mxCell><mxCell id="c20" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="TCP 3306 (red interna)" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=1.0000;exitY=0.0909;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.0909;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry" x="0.001"></mxGeometry></mxCell><mxCell id="c18" value="HTTP 127.0.0.1:8000" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=1.0000;exitY=0.2727;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.0909;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry" x="0.001"></mxGeometry></mxCell><mxCell id="c17" value="HTTPS :443" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=1.0000;exitY=0.8889;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1818;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry" x="0.001"></mxGeometry></mxCell><mxCell id="c23" value="EC2 Instance Connect" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=0.9200;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5455;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry" x="0.373"><Array as="points"><mxPoint x="280" y="580"/></Array></mxGeometry></mxCell><mxCell id="c22" value="SMTP" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=0.9286;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0833;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry" x="-0.15"><Array as="points"><mxPoint x="1060" y="220"/><mxPoint x="1530" y="220"/></Array></mxGeometry></mxCell><mxCell id="c24" value="docker compose · scripts de despliegue" style="fontFamily=Arial;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;edgeStyle=none;rounded=1;arcSize=6;exitX=1.0000;exitY=0.2222;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.9800;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry" x="0.288"><Array as="points"><mxPoint x="400" y="710"/><mxPoint x="400" y="660"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>