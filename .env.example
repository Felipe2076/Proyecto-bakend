# Copiar como .env y completar. NO subir .env a GitHub.
# Generar una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# En el servidor agregar el nombre de host, ej: ALLOWED_HOSTS=localhost,127.0.0.1,<host>
CSRF_TRUSTED_ORIGINS=

DB_NAME=gestion_muni
DB_USER=usuario_mysql
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Opcional y solo para pruebas locales. Si está definida, importar_json usa
# este único valor para todas las cuentas de simulación y no lo imprime.
# Si falta, genera una clave distinta por cuenta en .demo_credentials.local.
# SIGED_DEMO_PASSWORD=

# Correo del código de recuperación. Con DEBUG=True se usa la consola del
# proceso y el código no se muestra en la página.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=siged@localhost
