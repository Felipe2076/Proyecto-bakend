# Copiar como .env y completar. NO subir .env a GitHub.
# Generar una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# En EC2 agregar la IP pública o DNS, ej: ALLOWED_HOSTS=localhost,127.0.0.1,3.90.10.20
CSRF_TRUSTED_ORIGINS=

DB_NAME=gestion_muni
DB_USER=usuario_mysql
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
