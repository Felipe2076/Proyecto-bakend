# SIGED_CODE_HMAC_KEY=   # obligatoria en Docker (entrypoint); clave larga aleatoria
# SIGED_MEDIA_ROOT=/srv/siged/evidencias   # evidencias y fotos de perfil (volumen privado)
# SIGED_TOKEN_MOVIL_DIAS=30
# SIGED_OCULTAR_SIMULACION=0   # 1 = los indicadores excluyen datos marcados como simulación
# SIGED_CUENTA_PROTEGIDA=USR-025   # cuenta que no se puede desactivar
# Solo pruebas locales: SIGED_DB=sqlite y SIGED_SQLITE_PATH=...

