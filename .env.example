# Copiar a .env (no versionado, permisos 600) y completar. Nunca subir valores reales a Git.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,su-dominio-o-ip
CSRF_TRUSTED_ORIGINS=https://su-dominio-o-ip

# MySQL: usuario de la aplicación, nunca root. La clave root va en secretos/mysql_root.txt.
DB_NAME=siged
DB_USER=siged_app
DB_PASSWORD=

# Proxy inverso de confianza (Apache del host). Con Docker suele ser la puerta de enlace
# de la red "publica", p. ej. 172.18.0.1/32. Vacío: se ignoran X-Forwarded-*.
SIGED_PROXY_CONFIABLE=
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Cookies y cabeceras. HSTS solo con certificado válido y dominio propio (no con IP).
SIGED_COOKIES_SEGURAS=True
SIGED_REDIRIGIR_HTTPS=False
SIGED_HSTS_SEGUNDOS=0
SIGED_SESION_SEGUNDOS=28800

# Límites defensivos (por 15 minutos) y tamaño máximo de petición en bytes.
SIGED_LIMITE_LOGIN_IP=60
SIGED_LIMITE_LOGIN_CUENTA=8
SIGED_LIMITE_RECUPERAR_IP=10
SIGED_LIMITE_RECUPERAR_CORREO=3
SIGED_MAX_PETICION=12582912

# Correo de recuperación (contraseña de aplicación, nunca la personal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

SIGED_LOG_NIVEL=WARNING
GUNICORN_WORKERS=3

# --- Agregadas 2026-11-22 ---
